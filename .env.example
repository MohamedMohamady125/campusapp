# CampusConnect API configuration
# Copy to apps/api/.env for local development. Never commit real values.

# Environment: dev | test | prod
APP_ENV=dev

# --- Database ---
DATABASE_URL=postgresql+asyncpg://campus:campus@localhost:5434/campusconnect

# --- Redis ---
REDIS_URL=redis://localhost:6380/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-prod-min-32-bytes-long!
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Campus email domain students must register with
CAMPUS_EMAIL_DOMAIN=campus.edu

# --- Object storage (S3 / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=campusconnect
S3_REGION=us-east-1

# --- Email (real adapter used only when key present) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@campus.edu
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Moderation (stub when empty) ---
MODERATION_API_KEY=

# --- Payments (stub when empty; NEVER enable real charges without human review) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=

# --- CORS (web build origins, comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
